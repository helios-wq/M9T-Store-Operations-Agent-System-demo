# ========= 复制本文件为 .env 后填写 =========

# --- LLM（OpenAI 兼容，默认 DeepSeek）---
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 不填 LLM_API_KEY 时自动进入离线演示模式（内置规则回答，可跑通全流程）

# --- Embedding（OpenAI 兼容，推荐硅基流动 bge-m3 免费额度）---
EMBED_API_KEY=sk-your-embedding-api-key
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# --- 基础设施（连不上自动降级：Milvus->内存向量库, Redis->内存会话, MySQL->SQLite）---
MILVUS_HOST=localhost
MILVUS_PORT=19530
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=store_agent

# --- 监控告警（飞书群机器人 Webhook）---
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your-feishu-bot-key
ALERT_ERROR_RATE=0.05
ALERT_LATENCY_MS=3000

# --- 企业微信（明文模式回调验签 Token + 维修群机器人 Webhook）---
WECOM_TOKEN=storeagent
# 报修工单创建后自动推送到维修群（群机器人 Webhook，不填则跳过推送）
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-wecom-bot-key
